[Unit]
Description=mCare Laravel queue worker
After=network.target redis-server.service mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mcare/backend
ExecStart=/usr/bin/php artisan queue:work --sleep=1 --tries=3 --backoff=3 --timeout=90 --max-time=3600
ExecReload=/usr/bin/php artisan queue:restart
Restart=always
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM
PrivateTmp=true

[Install]
WantedBy=multi-user.target
