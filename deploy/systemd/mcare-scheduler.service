[Unit]
Description=mCare Laravel scheduler
After=network.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mcare/backend
ExecStart=/usr/bin/php artisan schedule:work
Restart=always
RestartSec=5
PrivateTmp=true

[Install]
WantedBy=multi-user.target
