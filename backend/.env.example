# ─────────────────────────────────────────────────────────────────────────
# mCare — backend environment template
#
# Copy this file to `.env` and fill in the real values.
# Real .env is git-ignored. NEVER commit real secrets to git.
# ─────────────────────────────────────────────────────────────────────────

APP_NAME=mCare
# For production: set APP_ENV=production, APP_DEBUG=false, APP_URL=https://api.yourdomain.com
APP_ENV=local
APP_KEY=
APP_DEBUG=true
MCARE_ALLOW_DEMO_SEED=false
APP_URL=http://127.0.0.1:8000
# Public URL of the Flutter web app — used for external-access links, OAuth redirects, email links
FRONTEND_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# 10 = faster hashing under load (recommended for production). 12 = safer, fine locally.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────
# Database (MySQL 8+ or MariaDB 10.6+)
# In production: dedicated user with a strong password, granted only this schema. Never root.
# For a remote database, set MYSQL_ATTR_SSL_CA to the provider CA certificate.
# ─────────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mcare
DB_USERNAME=root
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# README §4 — clients receive changes without this: every signal is buffered
# and served by GET /api/v1/me/pulse within seconds. Set reverb (and fill the
# REVERB_* block below) to add the millisecond WebSocket path on top. Signals
# publish inline, so no queue worker is required for real-time either way.
BROADCAST_CONNECTION=log

# The Flutter demo account picker signs in with an unverified "mock" token.
# Disabled by default; it can never sign in a doctor, assistant, or admin.
# Set to true only for an isolated local patient demonstration.
ALLOW_MOCK_SOCIAL_LOGIN=false
FILESYSTEM_DISK=local
MCARE_PRIVATE_DISK=local
MCARE_SESSION_TOKEN_MINUTES=480
MCARE_REMEMBER_TOKEN_MINUTES=43200
MCARE_MAX_DEVICE_SESSIONS=10
# Account recovery: emailed reset-link TTL and SMS OTP TTL, in minutes.
MCARE_RESET_TOKEN_MINUTES=60
MCARE_RESET_OTP_MINUTES=10

# One-time codes by SMS — account verification as well as password reset.
# `log` writes the code to the application log for local development and sends
# nothing; `twilio` sends for real. While this is `log`, "text me the code
# instead" is refused rather than silently dropped, so verification falls back
# to email alone. SMS_DEFAULT_COUNTRY_CODE (digits only, e.g. 234) is prefixed
# to numbers stored without one.
SMS_DRIVER=log
SMS_DEFAULT_COUNTRY_CODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# README §4.3 / §14 P0 #4 — production MUST be `redis` so SOS/vital-alert
# jobs don't block request/response. `database` is the safe local default
# (works out of the box without a Redis server).
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────
# Email (SMTP) — required for OTP, password reset, email verification, invites
#
# Default `log` driver writes emails to storage/logs/laravel.log instead of sending.
# Switch to `smtp` and configure the block below once you have credentials.
#
# Recommended — Resend (3000/month free, 100/day; plain SMTP, no extra package):
#   1. Sign up at https://resend.com and add your sending domain
#   2. Add the DKIM/SPF DNS records it shows you, then wait for "Verified"
#   3. Create an API key at https://resend.com/api-keys (starts with re_)
#   4. Set the five lines below:
#        MAIL_MAILER=smtp
#        MAIL_HOST=smtp.resend.com
#        MAIL_PORT=587
#        MAIL_USERNAME=resend
#        MAIL_PASSWORD=<re_... API key>
#      and point MAIL_FROM_ADDRESS at an address on the verified domain.
#   Before the domain verifies you can send only to your own signup address,
#   using MAIL_FROM_ADDRESS=onboarding@resend.dev.
#
# Alternative — Amazon SES ($0.10 per 1000 emails, cheapest at scale):
#   MAIL_HOST=email-smtp.<region>.amazonaws.com  MAIL_PORT=587
#   MAIL_USERNAME=<SES SMTP username>  MAIL_PASSWORD=<SES SMTP password>
#   New accounts start in a sandbox that only delivers to verified addresses
#   until AWS grants production access.
#
# Gmail is NOT a transactional mailer and must not be used with real users.
# A consumer account stops accepting mail after roughly 500 messages a day and
# answers "550-5.4.5 Daily user sending limit exceeded" for the rest of it,
# while still accepting the SMTP login — so credentials look fine and nothing
# is delivered. Every verification code and reset link then fails to send. The
# API reports that honestly rather than pretending, but the person still cannot
# get into their account. For local development only:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Generate: https://myaccount.google.com/apppasswords (16-char, no spaces)
#   3. Paste into MAIL_PASSWORD and set MAIL_MAILER=smtp
#
# Whatever you choose, prove it actually delivers before trusting it:
#   php artisan mcare:mail-test you@example.com
# `mcare:readiness` only checks that the login is accepted, which a capped
# mailbox keeps doing long after it has stopped delivering anything.
# ─────────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="support@example.com"
MAIL_REPLY_TO_NAME="mCare Support"
MAIL_SUPPORT_ADDRESS="support@example.com"

# ─────────────────────────────────────────────────────────────────────────
# AWS (S3 filesystem, SES — leave blank if not using AWS)
# ─────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────
# Google Sign-In (Web OAuth client)
#
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth client ID → Web application
#    - Authorized JavaScript origins: http://localhost:8090 (+ your prod URL)
#    - Authorized redirect URIs: matches GOOGLE_REDIRECT_URI below
# 3. Copy Client ID + Client secret here.
# 4. Frontend flag: --dart-define=MCARE_GOOGLE_CLIENT_ID=<same client ID>
# ─────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
# Comma-separated frontend hosts allowed to receive the OAuth return_to redirect.
# In production: your web-app domain(s), e.g. app.yourdomain.com
MCARE_ALLOWED_RETURN_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────────────────────────────────
# Apple Sign-In — requires an Apple Developer account ($99/yr)
#
# 1. https://developer.apple.com/account → Identifiers → Services IDs
# 2. Create Services ID (e.g. com.tattuintel.mcare.web) + Return URL (must be HTTPS)
# 3. Also register the App ID (e.g. com.tattuintel.mcare) for native
# 4. APPLE_CLIENT_ID: comma-separate to allow both web + native audiences.
# 5. Frontend: --dart-define=MCARE_APPLE_CLIENT_ID=<Services ID>
#              --dart-define=MCARE_APPLE_REDIRECT_URI=<HTTPS URL>
# ─────────────────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────────
# Firebase Cloud Messaging (FCM) — push notifications (SOS/critical alerts)
#
# 1. https://console.firebase.google.com → Add project
# 2. Project Settings → Service accounts → Generate new private key (JSON)
# 3. Save under backend/storage/app/firebase-service-account.json (git-ignored)
# 4. Web + Android app config goes into the Flutter dart-defines and
#    google-services.json — see README §"Environment & configuration".
#
# HTTP v1 only. Prefer the standard GOOGLE_APPLICATION_CREDENTIALS variable;
# FCM_SERVICE_ACCOUNT_PATH is supported as an app-specific fallback.
# FCM_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# FCM_SERVICE_ACCOUNT_PATH=storage/app/firebase-service-account.json
# Lock-screen push text is generic by default so patient details are fetched
# only after the authenticated app opens.
# ─────────────────────────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
FCM_REDACT_NOTIFICATION_CONTENT=true
FCM_TOKEN_TTL_DAYS=90

# ─────────────────────────────────────────────────────────────────────────
# Laravel Reverb (WebSockets) — README §7 primary real-time channel
#
# Reverb is already installed. Generate credentials with
# `php artisan reverb:install`, then set BROADCAST_CONNECTION=reverb above.
# Run alongside the API: `php artisan reverb:start --host=0.0.0.0 --port=8080`.
# The frontend discovers the public URL and app key from `/api/v1/config`; no
# WebSocket dart-defines are required for current builds.
# ─────────────────────────────────────────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
