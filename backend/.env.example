# ─────────────────────────────────────────────────────────────────────────
# mCare — backend environment template
#
# Copy this file to `.env` and fill in the real values.
# Real .env is git-ignored. NEVER commit real secrets to git.
# ─────────────────────────────────────────────────────────────────────────

APP_NAME=mCare
# For production: set APP_ENV=production, APP_DEBUG=false, APP_URL=https://api.yourdomain.com
APP_ENV=local
APP_KEY=
APP_DEBUG=true
MCARE_ALLOW_DEMO_SEED=false
APP_URL=http://127.0.0.1:8000
# Public URL of the Flutter web app — used for external-access links, OAuth redirects, email links
FRONTEND_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# 10 = faster hashing under load (recommended for production). 12 = safer, fine locally.
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────────────────────
# Database (MySQL 8+ or MariaDB 10.6+)
# In production: dedicated user with a strong password, granted only this schema. Never root.
# ─────────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mcare
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# README §7 / §10 — for production real-time, set BROADCAST_CONNECTION=reverb
# and fill the REVERB_* block below. `log` is the safe local default.
BROADCAST_CONNECTION=log

# The Flutter demo account picker signs in with an unverified "mock" token.
# Disabled by default; it can never sign in a doctor, assistant, or admin.
# Set to true only for an isolated local patient demonstration.
ALLOW_MOCK_SOCIAL_LOGIN=false
FILESYSTEM_DISK=local
MCARE_PRIVATE_DISK=local
MCARE_SESSION_TOKEN_MINUTES=480
MCARE_REMEMBER_TOKEN_MINUTES=43200
MCARE_MAX_DEVICE_SESSIONS=10
# Account recovery: emailed reset-link TTL and SMS OTP TTL, in minutes.
MCARE_RESET_TOKEN_MINUTES=60
MCARE_RESET_OTP_MINUTES=10

# Password-reset codes by SMS. `log` writes the code to the application log
# for local development; `twilio` sends for real. SMS_DEFAULT_COUNTRY_CODE
# (digits only, e.g. 234) is prefixed to numbers stored without one.
SMS_DRIVER=log
SMS_DEFAULT_COUNTRY_CODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# README §4.3 / §14 P0 #4 — production MUST be `redis` so SOS/vital-alert
# jobs don't block request/response. `database` is the safe local default
# (works out of the box without a Redis server).
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────
# Email (SMTP) — required for OTP, password reset, email verification, invites
#
# Default `log` driver writes emails to storage/logs/laravel.log instead of sending.
# Switch to `smtp` and configure the block below once you have credentials.
#
# How to get Gmail app-password:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Generate: https://myaccount.google.com/apppasswords (16-char code, no spaces)
#   3. Paste into MAIL_PASSWORD below and change MAIL_MAILER to smtp
#
# Production alternative — Amazon SES ($0.10 per 1000 emails):
#   MAIL_HOST=email-smtp.<region>.amazonaws.com
#   MAIL_USERNAME=<SES SMTP username>  MAIL_PASSWORD=<SES SMTP password>
# ─────────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────
# AWS (S3 filesystem, SES — leave blank if not using AWS)
# ─────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────
# Google Sign-In (Web OAuth client)
#
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create OAuth client ID → Web application
#    - Authorized JavaScript origins: http://localhost:8090 (+ your prod URL)
#    - Authorized redirect URIs: matches GOOGLE_REDIRECT_URI below
# 3. Copy Client ID + Client secret here.
# 4. Frontend flag: --dart-define=MCARE_GOOGLE_CLIENT_ID=<same client ID>
# ─────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
# Comma-separated frontend hosts allowed to receive the OAuth return_to redirect.
# In production: your web-app domain(s), e.g. app.yourdomain.com
MCARE_ALLOWED_RETURN_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────────────────────────────────
# Apple Sign-In — requires an Apple Developer account ($99/yr)
#
# 1. https://developer.apple.com/account → Identifiers → Services IDs
# 2. Create Services ID (e.g. com.tattuintel.mcare.web) + Return URL (must be HTTPS)
# 3. Also register the App ID (e.g. com.tattuintel.mcare) for native
# 4. APPLE_CLIENT_ID: comma-separate to allow both web + native audiences.
# 5. Frontend: --dart-define=MCARE_APPLE_CLIENT_ID=<Services ID>
#              --dart-define=MCARE_APPLE_REDIRECT_URI=<HTTPS URL>
# ─────────────────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────────
# Firebase Cloud Messaging (FCM) — push notifications (SOS/critical alerts)
#
# 1. https://console.firebase.google.com → Add project
# 2. Project Settings → Service accounts → Generate new private key (JSON)
# 3. Save under backend/storage/app/firebase-service-account.json (git-ignored)
# 4. Web + Android app config goes into the Flutter dart-defines and
#    google-services.json — see README §"Environment & configuration".
#
# Option A: HTTP v1 (recommended)
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_PATH=storage/app/firebase-service-account.json
#
# Option B: legacy Server Key
# FCM_SERVER_KEY=
# ─────────────────────────────────────────────────────────────────────────
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVER_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Laravel Reverb (WebSockets) — README §7 primary real-time channel
#
# Not required for local dev. Fill these once you `composer require laravel/reverb`
# and run `php artisan reverb:install`. Also set BROADCAST_CONNECTION=reverb above.
# Run alongside the API: `php artisan reverb:start --host=0.0.0.0 --port=8080`
# Frontend counterpart: --dart-define=MCARE_WS_URL=ws://127.0.0.1:8080
# ─────────────────────────────────────────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
